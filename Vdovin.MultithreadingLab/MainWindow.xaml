<Window x:Class="Vdovin.MultithreadingLab.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сравнение подходов — одна кнопка" Height="500" Width="600">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Введите число:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox x:Name="txtValue" Grid.Row="0" Grid.Column="1" Margin="5"/>

        <Button Content="Запустить всё" Grid.Row="1" Grid.ColumnSpan="2" Margin="5" Click="BtnRunAll_Click"/>

        <TextBlock Text="Однопоточно:" Grid.Row="2" VerticalAlignment="Center"/>
        <TextBlock x:Name="lblSingle" Grid.Row="2" Grid.Column="1" TextWrapping="Wrap"/>

        <TextBlock Text="Через Task:" Grid.Row="3" VerticalAlignment="Center"/>
        <TextBlock x:Name="lblTask" Grid.Row="3" Grid.Column="1" TextWrapping="Wrap"/>

        <TextBlock Text="Асинхронно:" Grid.Row="4" VerticalAlignment="Center"/>
        <TextBlock x:Name="lblAsync" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap"/>

        <TextBlock Text="Общее время:" Grid.Row="5" VerticalAlignment="Center"/>
        <TextBlock x:Name="lblTotalTime" Grid.Row="5" Grid.Column="1" TextWrapping="Wrap"/>

        <TextBlock Text="Статус:" Grid.Row="6" VerticalAlignment="Center"/>
        <TextBlock x:Name="lblStatus" Grid.Row="6" Grid.Column="1" TextWrapping="Wrap" Foreground="Gray"/>

        <TextBlock x:Name="lblDigits" Grid.Row="7" Grid.ColumnSpan="2" TextWrapping="Wrap" FontStyle="Italic"/>
    </Grid>
</Window>